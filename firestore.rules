rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // 0. GLOBAL HELPER FUNCTIONS (Zero-Trust Security Model)
    // -------------------------------------------------------------------------
    function isAuth() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isAuth() && request.auth.token.role == 'admin';
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Default Deny on all paths (OWASP ASVS Level 3 Zero-Trust)
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // 1. PUBLIC STOREFRONT CATALOG: Read-Only for Visitors, Write for Admin
    // -------------------------------------------------------------------------
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 2. CUSTOMER PROFILES: Self-Access Only & Anti-Privilege Escalation
    // -------------------------------------------------------------------------
    match /customers/{customerId} {
      allow read: if isOwner(customerId) || isAdmin();
      allow create: if isOwner(customerId)
        && request.resource.data.id == customerId
        && request.resource.data.role == 'customer'
        && request.resource.data.createdAt <= request.time.toMillis();
      allow update: if (isOwner(customerId)
        && request.resource.data.id == customerId
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.role == 'customer' || isAdmin()))
        || isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 3. ORDERS: Customer Owner Read, Admin Full Management
    // -------------------------------------------------------------------------
    match /orders/{orderId} {
      allow read: if isAdmin() || (isAuth() && resource.data.customerId == request.auth.uid);
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 4. REVIEWS: Approved-Only Public Read, Pending-Only User Create, Admin Write
    // -------------------------------------------------------------------------
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isAuth()
        && request.resource.data.id == reviewId
        && request.resource.data.status == 'pending'
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.timestamp <= request.time.toMillis();
      allow update, delete: if isAdmin();
    }
  }
}
