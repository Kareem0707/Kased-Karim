# =============================================================================
# KASED KARIM LUXURY LIGHTING - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Security Standard: OWASP ASVS Level 3 & NIST SP 800-63B
# IMPORTANT: DO NOT commit real secrets to Git. Copy this file to .env locally
# or configure these environment variables in your Vercel Project Settings / Docker host.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PRIMARY RELATIONAL DATABASE (POSTGRESQL & DOCKER COMPOSE)
# Mandatory for Docker stack: DB_PASSWORD is strictly required (Fail-Closed)
# -----------------------------------------------------------------------------
DB_NAME=kased_karim_db
DB_USER=kased_admin
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=
BACKUP_RETENTION_DAYS=14
S3_BACKUP_BUCKET=

# -----------------------------------------------------------------------------
# 2. ADMINISTRATIVE AUTHENTICATION & ACCESS CONTROL (CRITICAL)
# ADMIN_PASSWORD and ADMIN_JWT_SECRET are mandatory (Fail-Closed)
# -----------------------------------------------------------------------------
# Master administrator password (Minimum 16 characters, high entropy)
ADMIN_PASSWORD=

# Master JWT signing secret (Minimum 64-character / 256-bit random hex string)
# Generate via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_JWT_SECRET=

# Optional scrypt password hash & salt for memory-hard verification
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_SALT=

# Optional dedicated customer portal JWT signing secret (64-character hex)
CUSTOMER_JWT_SECRET=

# -----------------------------------------------------------------------------
# 3. TWO-FACTOR AUTHENTICATION (2FA OTP) & NOTIFICATIONS
# -----------------------------------------------------------------------------
# Comma-separated authorized admin emails to receive 2FA OTP codes
ADMIN_2FA_EMAILS=

# HMAC secret for 2FA challenge ID generation (32-character hex)
ADMIN_2FA_SECRET=

# Optional SMS / WhatsApp webhook URL for OTP dispatch
OTP_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# 4. CLOUD DATABASE (FIREBASE REALTIME DATABASE - FAIL-CLOSED VAULT)
# -----------------------------------------------------------------------------
# Firebase Realtime Database URL (Strict HTTPS required, e.g. https://<project-id>-default-rtdb.firebaseio.com)
FIREBASE_DB_URL=

# Server-Side Database Secret / Admin Token
FIREBASE_DB_SECRET=

# -----------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL PROVIDERS (2FA OTP & NOTIFICATIONS)
# -----------------------------------------------------------------------------
# Resend API Provider
RESEND_API_KEY=
RESEND_FROM=

# Brevo (Sendinblue) Fallback API Provider
BREVO_API_KEY=
BREVO_SENDER=

# -----------------------------------------------------------------------------
# 6. GOOGLE IDENTITY SERVICES (GIS / OAUTH 2.0)
# -----------------------------------------------------------------------------
# Google Cloud Console Web Application Client ID
GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# 7. DISTRIBUTED RATE LIMITING (@upstash/ratelimit & @upstash/redis)
# -----------------------------------------------------------------------------
# Upstash Redis REST API credentials for Serverless Sliding Window Rate Limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel KV aliases (supported seamlessly if using Vercel KV integration)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# -----------------------------------------------------------------------------
# 8. NETWORK POLICIES & CORS ALLOWLISTS
# -----------------------------------------------------------------------------
# Comma-separated allowed CORS origins (Production strictly requires https://)
ALLOWED_ORIGINS=https://kasedkarim.com,https://www.kasedkarim.com

# Comma-separated allowed image hosts for SSRF-safe catalog images
ALLOWED_IMAGE_HOSTS=images.unsplash.com,res.cloudinary.com

# -----------------------------------------------------------------------------
# 9. VERCEL CRON SECURITY & APPLICATION URL
# -----------------------------------------------------------------------------
# Cryptographic Bearer secret for authenticating daily Vercel Cron jobs (/api/cron/cleanup-unverified)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Public application base URL
APP_URL=https://kasedkarim.com

# -----------------------------------------------------------------------------
# 10. CLOUDFLARE TURNSTILE BOT PROTECTION (ANTI-AUTOMATION & SPAM DEFENSE)
# -----------------------------------------------------------------------------
# Cloudflare Turnstile Public Site Key (Visible to frontend forms)
TURNSTILE_SITE_KEY=

# Cloudflare Turnstile Secret Key (Server-side validation)
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# 11. LOCAL RUNTIME & SERVER CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
